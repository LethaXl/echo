# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, set these in Project Settings > Environment Variables.

# Supabase (Project Settings > API). The publishable key is safe for the browser;
# it relies on Row Level Security to protect data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TMDB API Read Access Token (server-side only, never prefix with NEXT_PUBLIC_).
TMDB_API_TOKEN=

# Never add the Supabase service role / secret key with a NEXT_PUBLIC_ prefix.
