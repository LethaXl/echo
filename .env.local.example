
# ============================================================
# Echo | Environment Variables
# ============================================================
#
# SETUP INSTRUCTIONS
#
# 1. Copy this file and rename the copy to ".env.local".
# 2. Create a Supabase project at https://supabase.com
# 3. Get a TMDB API token at https://www.themoviedb.org/settings/api
# 4. Fill in the three values below.
# 5. Run "npm install" and then "npm run dev".
#
# IMPORTANT:
# - Never commit .env.local to GitHub.
# - Do not add quotation marks unless your value requires them.
# - Restart the development server after changing this file.
#
# ============================================================


# ------------------------------------------------------------
# 1. SUPABASE PROJECT URL
# ------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
#
# Example: https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_URL=


# ------------------------------------------------------------
# 2. SUPABASE PUBLISHABLE KEY
# ------------------------------------------------------------
# Supabase Dashboard > Project Settings > API Keys
#
# Copy the publishable key (sb_publishable_...).
# This key is designed for browser use.
# Database access must be protected by RLS policies.

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------
# 3. TMDB API READ ACCESS TOKEN
# ------------------------------------------------------------
# Get your token at:
# https://www.themoviedb.org/settings/api
#
# Copy the API Read Access Token (v4 auth).
# Do not use the shorter API Key (v3).
#
# This token must remain server-side.

TMDB_API_TOKEN=


# ============================================================
# DEPLOYMENT (VERCEL)
# ============================================================
#
# For deployment, add these same three variables under:
#
# Vercel > Project > Settings > Environment Variables
#
# Never expose TMDB_API_TOKEN or Supabase secret keys
# using the NEXT_PUBLIC_ prefix.
#
# ============================================================
